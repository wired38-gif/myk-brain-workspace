+
+    const root = el(`
+<div class="aq-nav" id="aq-nav" aria-live="polite">
+  <div class="aq-panel" id="aq-panel" role="dialog" aria-label="Admin Queen navigator" hidden>
+    <div class="aq-header">
+      <img src="../assets/artist.jpg" alt="The Vibe Queen" width="40" height="40" onerror="this.outerHTML='<span style=&quot;font-size:1.6rem&quot;>👑</span>'"/>
+      <div class="aq-header-text">
+        <strong>Admin Queen</strong>
+        <span>Find anything · I’ll take you there</span>
+      </div>
+      <button type="button" class="aq-close" id="aq-close" aria-label="Close">×</button>
+    </div>
+    <div class="aq-messages" id="aq-messages"></div>
+    <div class="aq-chips" id="aq-chips"></div>
+    <form class="aq-form" id="aq-form">
+      <input type="search" id="aq-input" placeholder="Find Stripe, orders, Etsy…" autocomplete="off"/>
+      <button type="submit" class="aq-send">Go</button>
+    </form>
+  </div>
+  <button type="button" class="aq-fab" id="aq-fab" aria-label="Open Admin Queen" aria-expanded="false">
+    <span class="aq-fab-pulse" aria-hidden="true"></span>
+    <img src="../assets/artist.jpg" alt="" onerror="this.outerHTML='<span>👑</span>'"/>
+  </button>
+  <div class="aq-tip" id="aq-tip">Ask me where something is 👑</div>
+</div>`);
+
+    document.body.appendChild(root);
+
+    const panel = document.getElementById('aq-panel');
+    const fab = document.getElementById('aq-fab');
+    const log = document.getElementById('aq-messages');
+    const chips = document.getElementById('aq-chips');
+    const form = document.getElementById('aq-form');
+    const input = document.getElementById('aq-input');
+    const tip = document.getElementById('aq-tip');
+
+    function open() {
+      root.classList.add('open');
+      panel.hidden = false;
+      fab.setAttribute('aria-expanded', 'true');
+      tip.classList.remove('show');
+      if (!log.dataset.greeted) {
+        addBubble(
+          log,
+          'Hey Queen 👑 I’m your <strong>Admin navigator</strong>. Ask where something is — “Stripe”, “orders”, “inquiries” — and I’ll open it. I work in <em>Operations</em> and <em>Setup</em>.',
+          'queen'
+        );
+        log.dataset.greeted = '1';
+      }
+      setTimeout(() => input.focus(), 100);
+    }
+
+    function close() {
+      root.classList.remove('open');
+      fab.setAttribute('aria-expanded', 'false');
+      setTimeout(() => {
+        if (!root.classList.contains('open')) panel.hidden = true;
+      }, 200);
+    }
+
+    QUICK.forEach((item) => {
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.className = 'aq-chip';
+      btn.textContent = item.label;
+      btn.addEventListener('click', () => handleQuery(item.q, log, input));
+      chips.appendChild(btn);
+    });
+
+    fab.addEventListener('click', () => {
+      if (root.classList.contains('open')) close();
+      else open();
+    });
+    document.getElementById('aq-close').addEventListener('click', close);
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      handleQuery(input.value, log, input);
+    });
+
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && root.classList.contains('open')) close();
+      // Ctrl/Cmd+K — quick find
+      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
+        e.preventDefault();
+        if (!document.body.classList.contains('authed')) return;
+        open();
+      }
+    });
+
+    setTimeout(() => tip.classList.add('show'), 1600);
+    setTimeout(() => tip.classList.remove('show'), 6500);
+
+    // Expose search for bridge/debug
+    window.QCCAdminQueen.search = searchIndex;
+    window.QCCAdminQueen.open = open;
+  }
+
+  window.QCCAdminQueen = {
+    init: init,
+    index: ADMIN_INDEX,
+    search: searchIndex,
+  };
+})();
