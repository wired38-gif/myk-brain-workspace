+  const QUICK = [
+    { label: 'Find Stripe', q: 'stripe' },
+    { label: 'Orders', q: 'orders' },
+    { label: 'Inquiries', q: 'inquiries' },
+    { label: 'Open Setup', q: 'setup wizard' },
+    { label: 'What is an API key?', q: 'what is an api key' },
+  ];
+
+  let bridge = null;
+
+  function esc(s) {
+    return String(s || '')
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;');
+  }
+
+  function scoreEntry(entry, q) {
+    const t = q.toLowerCase().trim();
+    if (!t) return 0;
+    let score = 0;
+    const title = entry.title.toLowerCase();
+    const blurb = entry.blurb.toLowerCase();
+    if (title === t) score += 100;
+    if (title.includes(t)) score += 40;
+    if (blurb.includes(t)) score += 10;
+    entry.keywords.forEach((k) => {
+      const kw = k.toLowerCase();
+      if (kw === t) score += 50;
+      else if (t.includes(kw) || kw.includes(t)) score += 24;
+      else {
+        const parts = t.split(/\s+/);
+        parts.forEach((p) => {
+          if (p.length > 2 && (kw.includes(p) || p.includes(kw))) score += 8;
+        });
+      }
+    });
+    return score;
+  }
+
+  function searchIndex(q, limit) {
+    limit = limit || 6;
+    return ADMIN_INDEX
+      .map((e) => ({ entry: e, score: scoreEntry(e, q) }))
+      .filter((x) => x.score > 0)
+      .sort((a, b) => b.score - a.score)
+      .slice(0, limit)
+      .map((x) => x.entry);
+  }
+
+  function el(html) {
+    const t = document.createElement('template');
+    t.innerHTML = html.trim();
+    return t.content.firstElementChild;
+  }
+
+  function addBubble(log, text, who) {
+    const b = document.createElement('div');
+    b.className = 'aq-bubble ' + who;
+    b.innerHTML = text;
+    log.appendChild(b);
+    log.scrollTop = log.scrollHeight;
+    return b;
+  }
+
+  function renderHits(log, hits, preface) {
+    if (preface) addBubble(log, preface, 'queen');
+    if (!hits.length) {
+      addBubble(log, 'I couldn’t find that in the index. Try “Stripe”, “orders”, “inquiries”, or “Etsy”. Or ask in everyday words.', 'queen');
+      return;
+    }
+    const wrap = document.createElement('div');
+    wrap.className = 'aq-hits';
+    hits.forEach((h) => {
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.className = 'aq-hit';
+      btn.innerHTML = '<strong>' + esc(h.title) + '</strong><span>' + esc(h.blurb) + '</span>';
+      btn.addEventListener('click', () => go(h, log));
+      wrap.appendChild(btn);
+    });
+    log.appendChild(wrap);
+    log.scrollTop = log.scrollHeight;
+  }
+
+  function go(entry, log) {
+    if (!bridge) return;
+    addBubble(log, 'Taking you to <strong>' + esc(entry.title) + '</strong>…', 'queen');
+    bridge.navigate(entry.target);
+    if (entry.target.ask && typeof bridge.askSetupCoach === 'function') {
+      setTimeout(() => bridge.askSetupCoach(entry.target.ask), 400);
+    }
+  }
+
+  async function handleQuery(q, log, input) {
+    const query = (q || '').trim();
+    if (!query) return;
+    addBubble(log, esc(query), 'user');
+    if (input) input.value = '';
+
+    const hits = searchIndex(query);
+    if (hits.length) {
+      renderHits(
+        log,
+        hits,
+        hits.length === 1
+          ? 'Found it — tap below and I’ll take you there:'
+          : 'Here’s what matches in your admin index — tap one:'
+      );
+      // Auto-jump when it's an obvious single strong match
+      if (hits.length === 1 && scoreEntry(hits[0], query) >= 40) {
+        setTimeout(() => go(hits[0], log), 350);
+      }
+      return;
+    }
+
+    // Fall through to Setup Coach API for free-form help
+    if (bridge && typeof bridge.askAdminCoach === 'function') {
+      addBubble(log, 'Searching my notes…', 'queen');
+      try {
+        const reply = await bridge.askAdminCoach(query);
+        // remove "Searching…" last queen bubble if it's the placeholder — keep simple: just append
+        addBubble(log, reply || 'Try asking “where is Stripe?” or “open orders”.', 'queen');
+        const again = searchIndex(query);
+        if (again.length) renderHits(log, again, 'Or jump here:');
+      } catch (_) {
+        addBubble(log, 'Try words like <strong>Stripe</strong>, <strong>orders</strong>, <strong>inquiries</strong>, or <strong>Setup</strong>.', 'queen');
+      }
+      return;
+    }
+
+    addBubble(log, 'Try “Stripe”, “orders”, “products”, or “open Setup”.', 'queen');
+  }
+
