+  }
+  return "Got it — leave your name, email, and message if you want a personal reply (usually within 24 hours). Or ask me about customs, shipping, or bulk 💕";
+}
+
+async function tryOpenAIQueenChat(message) {
+  const apiKey = (process.env.SETUP_COACH_API_KEY || process.env.OPENAI_API_KEY || '').trim();
+  if (!apiKey) return null;
+
+  const model = (process.env.SETUP_COACH_MODEL || 'gpt-4o-mini').trim();
+  const baseUrl = (process.env.SETUP_COACH_BASE_URL || 'https://api.openai.com/v1').replace(/\/$/, '');
+
+  const system = [
+    'You are The Vibe Queen, owner of Queens Custom Creations (queenscustoms.shop).',
+    'You handcraft glitter tumblers and customs. Tone: warm, confident, playful, short (under 120 words).',
+    'Answer shop questions: pricing (customs from ~$40), shipping (~2–3 weeks), custom designs, bulk/party orders.',
+    'Do not invent order tracking numbers or claim a payment went through.',
+    'If they want a custom quote, invite them to leave name/email in the chat form or use Queens Studio.',
+    'Never ask for credit card numbers or passwords.',
+  ].join(' ');
+
+  const url = `${baseUrl}/chat/completions`;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 20000);
+
+  try {
+    const res = await fetch(url, {
+      method: 'POST',
+      headers: {
+        Authorization: `Bearer ${apiKey}`,
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({
+        model,
+        temperature: 0.6,
+        max_tokens: 280,
+        messages: [
