+function ruleBasedQueenChat(message) {
+  const t = String(message || '').toLowerCase();
+  if (/price|cost|how much|\$/.test(t)) {
+    return "Customs start at $40. Price depends on size, glitter, and how detailed your design is — drop what you're dreaming up and I'll quote you 👑";
+  }
+  if (/ship|deliver|turnaround|how long|week/.test(t)) {
+    return "Most customs ship in about 2–3 weeks (bulk can take longer). Rush options are available when I have studio space — ask and I'll check!";
+  }
+  if (/design|upload|photo|logo|custom idea|inspo/.test(t)) {
+    return "Yes queen! Upload inspo, a screenshot, or describe the vibe in Queens Studio / this chat. I'll make it one-of-a-kind.";
+  }
+  if (/bulk|party|squad|bridal|team|dozen/.test(t)) {
+    return "Absolutely — birthday squads, bridal parties, team cups, all of it. Tell me quantity + theme and I'll send bulk pricing.";
+  }
+  return "Got it — leave your name, email, and message if you want a personal reply (usually within 24 hours). Or ask me about customs, shipping, or bulk 💕";
+}
+
+async function tryOpenAIQueenChat(message) {
+  const apiKey = (process.env.SETUP_COACH_API_KEY || process.env.OPENAI_API_KEY || '').trim();
+  if (!apiKey) return null;
+
+  const model = (process.env.SETUP_COACH_MODEL || 'gpt-4o-mini').trim();
+  const baseUrl = (process.env.SETUP_COACH_BASE_URL || 'https://api.openai.com/v1').replace(/\/$/, '');
+
+  const system = [
+    'You are The Vibe Queen, owner of Queens Custom Creations (queenscustoms.shop).',
+    'You handcraft glitter tumblers and customs. Tone: warm, confident, playful, short (under 120 words).',
+    'Answer shop questions: pricing (customs from ~$40), shipping (~2–3 weeks), custom designs, bulk/party orders.',
+    'Do not invent order tracking numbers or claim a payment went through.',
+    'If they want a custom quote, invite them to leave name/email in the chat form or use Queens Studio.',
+    'Never ask for credit card numbers or passwords.',
+  ].join(' ');
+
+  const url = `${baseUrl}/chat/completions`;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 20000);
+
+  try {
+    const res = await fetch(url, {
+      method: 'POST',
+      headers: {
+        Authorization: `Bearer ${apiKey}`,
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({
+        model,
+        temperature: 0.6,
+        max_tokens: 280,
+        messages: [
+          { role: 'system', content: system },
+          { role: 'user', content: String(message || '').slice(0, 1500) },
+        ],
+      }),
+      signal: controller.signal,
+    });
+    if (!res.ok) {
+      const body = await res.text().catch(() => '');
+      throw new Error(`LLM HTTP ${res.status}: ${body.slice(0, 200)}`);
+    }
+    const data = await res.json();
+    const reply = data?.choices?.[0]?.message?.content?.trim();
+    if (!reply) throw new Error('Empty LLM reply');
+    return { reply, model, source: 'llm' };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+async function answerQueenChat(message) {
+  const text = String(message || '').trim();
+  if (!text) {
+    return { error: 'Message required', status: 400 };
