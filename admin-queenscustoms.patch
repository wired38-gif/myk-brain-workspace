+<script>
+const API = '';
+let TOKEN = sessionStorage.getItem('admin_token') || localStorage.getItem('admin_token');
+let currentInquiryId = null;
+let currentOrderId = null;
+
+// ── Auth guard ────────────────────────────────────────────────────────────────
+if (!TOKEN) { window.location.href = '/admin/login'; }
+
+async function api(path, opts = {}) {
+  const res = await fetch(API + path, {
+    ...opts,
+    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${TOKEN}`, ...(opts.headers || {}) },
+  });
+  if (res.status === 401) { logout(); return null; }
+  return res;
+}
+
+function logout() {
+  sessionStorage.removeItem('admin_token'); localStorage.removeItem('admin_token');
+  window.location.href = '/admin/login';
+}
+
+// ── Tab system ────────────────────────────────────────────────────────────────
+const tabs = ['overview', 'orders', 'inquiries', 'products', 'users'];
+const titles = { overview: ['Overview','Store performance summary'], orders: ['Orders','Manage fulfillment & status'], inquiries: ['Customer Inquiries','View & reply to messages'], products: ['Products','Inventory & pricing management'], users: ['Admin Users','Manage portal access'] };
+
+function showTab(name) {
+  tabs.forEach(t => {
+    document.getElementById(`tab-${t}`).classList.toggle('hidden', t !== name);
+    const nav = document.getElementById(`nav-${t}`);
+    if (nav) { nav.classList.toggle('active', t === name); nav.classList.toggle('text-slate-400', t !== name); }
+  });
+  const [title, sub] = titles[name];
+  document.getElementById('page-title').textContent = title;
+  document.getElementById('page-subtitle').textContent = sub;
+  if (name === 'overview') loadOverview();
+  if (name === 'orders') loadOrders();
+  if (name === 'inquiries') loadInquiries();
+  if (name === 'products') loadProducts();
+  if (name === 'users') loadUsers();
+  closeSidebar();
+}
+
+// ── Data loading ──────────────────────────────────────────────────────────────
+let ordersData = [], inquiriesData = [], productsData = [];
+
+async function loadOverview() {
+  const [o, i, p] = await Promise.all([loadOrders(true), loadInquiries(true), loadProducts(true)]);
+  const stats = document.getElementById('overview-stats');
+  stats.innerHTML = `
+    <div class="card rounded-2xl p-5">
+      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Total Revenue</div>
+      <div class="text-2xl font-extrabold text-white mono">$${o.stats?.revenue || '0.00'}</div>
+      <div class="text-xs text-slate-500 mt-1">${o.stats?.total || 0} orders total</div>
+    </div>
+    <div class="card rounded-2xl p-5">
+      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Pending Orders</div>
+      <div class="text-2xl font-extrabold text-amber-400 mono">${o.stats?.pending || 0}</div>
+      <div class="text-xs text-slate-500 mt-1">${o.stats?.processing || 0} processing</div>
+    </div>
+    <div class="card rounded-2xl p-5">
+      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">New Inquiries</div>
+      <div class="text-2xl font-extrabold text-blue-400 mono">${(i||[]).filter(x=>x.status==='new').length}</div>
+      <div class="text-xs text-slate-500 mt-1">${(i||[]).length} total messages</div>
+    </div>
+    <div class="card rounded-2xl p-5">
+      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Products</div>
+      <div class="text-2xl font-extrabold text-emerald-400 mono">${p.stats?.active || 0}</div>
+      <div class="text-xs text-slate-500 mt-1">${p.stats?.outOfStock || 0} out of stock</div>
+    </div>`;
+
+  // Recent
+  document.getElementById('recent-orders-list').innerHTML = ordersData.slice(0,5).map(o => `
+    <div class="flex items-center justify-between py-2.5 border-b border-slate-800/50 last:border-0">
+      <div>
+        <div class="text-sm font-semibold text-white mono">${o.orderNumber}</div>
+        <div class="text-xs text-slate-500">${o.customer.name}</div>
+      </div>
+      <span class="status-pill status-${o.status}">${o.status}</span>
+    </div>`).join('');
+
+  document.getElementById('recent-inquiries-list').innerHTML = inquiriesData.filter(i=>i.status==='new').slice(0,5).map(i => `
+    <div class="flex items-center justify-between py-2.5 border-b border-slate-800/50 last:border-0">
+      <div>
+        <div class="text-sm font-semibold text-white">${i.name}</div>
+        <div class="text-xs text-slate-500 truncate max-w-[200px]">${i.subject}</div>
+      </div>
+      <button onclick="showTab('inquiries')" class="text-xs text-blue-400 hover:text-blue-300 font-semibold">Reply →</button>
+    </div>`).join('') || '<p class="text-slate-600 text-sm py-4 text-center">No new inquiries</p>';
+}
+
+async function loadOrders(returnData = false) {
+  const res = await api('/api/admin/orders');
+  if (!res) return {};
+  const data = await res.json();
+  ordersData = data.orders || [];
+
+  if (!returnData) {
+    const badge = document.getElementById('orders-badge');
+    badge.textContent = data.stats?.pending || 0;
+    badge.classList.toggle('hidden', !data.stats?.pending);
+
+    const tbody = document.getElementById('orders-tbody');
+    if (tbody) tbody.innerHTML = ordersData.map(o => `
+      <tr>
+        <td class="px-5 py-3.5 mono text-xs font-semibold text-blue-400">${o.orderNumber}</td>
+        <td class="px-5 py-3.5"><div class="font-semibold text-sm text-white">${o.customer.name}</div><div class="text-[11px] text-slate-500">${o.customer.email}</div></td>
+        <td class="px-5 py-3.5 text-slate-400 text-xs hidden md:table-cell">${o.channel}</td>
+        <td class="px-5 py-3.5 mono text-sm font-bold text-white">$${o.total}</td>
+        <td class="px-5 py-3.5"><span class="status-pill status-${o.status}">${o.status}</span></td>
+        <td class="px-5 py-3.5 text-slate-500 text-xs hidden lg:table-cell">${new Date(o.createdAt).toLocaleDateString()}</td>
+        <td class="px-5 py-3.5"><button onclick="openOrderModal('${o.id}','${o.orderNumber}','${o.status}')" class="text-xs text-blue-400 hover:text-blue-300 font-semibold whitespace-nowrap">Update →</button></td>
+      </tr>`).join('');
+  }
+  return data;
+}
+
+async function loadInquiries(returnData = false) {
+  const res = await api('/api/admin/inquiries');
+  if (!res) return [];
+  inquiriesData = await res.json();
+
+  if (!returnData) {
