+                <span class="w-4 h-4 rounded bg-indigo-500/20 flex items-center justify-center text-[10px] font-bold text-indigo-400">S</span>
+                Stripe Dashboard
+              </a>
+              <a href="https://seller.amazon.com" target="_blank" rel="noopener" class="flex items-center gap-2 text-xs text-slate-500 hover:text-slate-300 transition-colors">
+                <span class="w-4 h-4 rounded bg-yellow-500/20 flex items-center justify-center text-[10px]">A</span>
+                Amazon Seller Central
+              </a>
+              <a href="https://partner.tiktokshop.com" target="_blank" rel="noopener" class="flex items-center gap-2 text-xs text-slate-500 hover:text-slate-300 transition-colors">
+                <span class="w-4 h-4 rounded bg-pink-500/20 flex items-center justify-center text-[10px]">T</span>
+                TikTok Shop Partner
+              </a>
+            </div>
+          </div>
+        </div>
+      </div>
+
+    </div><!-- /flex -->
+  </main>
+
+<script>
+const API = '';
+let TOKEN = sessionStorage.getItem('admin_token') || localStorage.getItem('admin_token');
+if (!TOKEN) window.location.href = '/admin/login';
+
+let currentStep = 0;
+const TOTAL_STEPS = 7;
+let integrationSettings = {};
+
+const AI_TIPS = [
+  {
+    tip: "Welcome! This wizard will guide you through connecting your sales channels, payment providers, and more. Each step saves automatically — you can return anytime.",
+    actions: [{ label: '→ Start with E-Commerce', fn: 'nextStep()' }]
+  },
+  {
+    tip: "Connect your Etsy, Amazon, and TikTok Shop accounts. You'll need API keys from each platform's developer portal. Click the 'Get API Key' links next to each channel.",
+    actions: [{ label: '🔗 Etsy Developers', url: 'https://www.etsy.com/developers' }, { label: '🛒 Amazon Seller Central', url: 'https://sellercentral.amazon.com' }]
+  },
+  {
+    tip: "Stripe is recommended for most sellers — it supports cards, Apple Pay, and Google Pay. Use your Stripe Dashboard to find your API keys under Developers → API Keys.",
+    actions: [{ label: '💳 Open Stripe Dashboard', url: 'https://dashboard.stripe.com/apikeys' }]
+  },
+  {
+    tip: "Klaviyo is great for e-commerce businesses — it integrates directly with Shopify/WooCommerce. Mailchimp is simpler if you're just starting with email marketing.",
+    actions: [{ label: '📧 Compare Platforms', url: 'https://klaviyo.com' }]
+  },
+  {
+    tip: "Review and update your product inventory, pricing, and status here. Items showing 0 in stock will be marked out of stock automatically.",
+    actions: []
+  },
+  {
+    tip: "Add team members who need access to the admin portals. Each admin can independently manage orders, inquiries, and products.",
+    actions: []
+  },
+  {
+    tip: "All done! Your setup is saved. Remember to update your API keys when they rotate, and check the Operations dashboard regularly for new orders and inquiries.",
+    actions: [{ label: '📊 Go to Operations', url: '/admin/operations' }]
+  }
+];
+
+async function api(path, opts = {}) {
+  const res = await fetch(API + path, {
+    ...opts,
+    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${TOKEN}`, ...(opts.headers || {}) },
+  });
+  if (res.status === 401) { logout(); return null; }
+  return res;
+}
+
+function logout() {
+  sessionStorage.removeItem('admin_token'); localStorage.removeItem('admin_token');
+  window.location.href = '/admin/login';
+}
+
+// ── Step navigation ────────────────────────────────────────────────────────────
+function goToStep(n) {
+  if (n < 0 || n >= TOTAL_STEPS) return;
+  document.querySelectorAll('.step-panel').forEach((el, i) => el.classList.toggle('hidden', i !== n));
+  updateStepUI(n);
+  currentStep = n;
+  if (n === 4) loadWizardProducts();
+  if (n === 5) loadWizardUsers();
+  closeSidebar();
+}
+
+function nextStep() { goToStep(currentStep + 1); }
+function prevStep() { goToStep(currentStep - 1); }
+
+function updateStepUI(n) {
+  const bar = document.getElementById('progress-bar');
+  const txt = document.getElementById('progress-text');
+  const pct = Math.round(((n + 1) / TOTAL_STEPS) * 100);
+  if (bar) bar.style.width = pct + '%';
+  if (txt) txt.textContent = `${n + 1}/${TOTAL_STEPS}`;
+
+  for (let i = 0; i < TOTAL_STEPS; i++) {
+    const dot = document.getElementById(`dot-${i}`);
+    const sdot = document.getElementById(`sdot-${i}`);
+    const snav = document.getElementById(`snav-${i}`);
+    const conn = document.getElementById(`conn-${i}`);
+    const cls = i < n ? 'completed' : i === n ? 'current' : 'pending';
+
+    if (dot) { dot.className = `step-dot ${cls}`; if (cls==='current') dot.classList.add('pulse-ring'); if (cls==='completed') dot.innerHTML='✓'; }
+    if (sdot) { sdot.className = `step-dot ${cls} text-[10px]`; if (cls==='completed') sdot.innerHTML='✓'; }
+    if (snav) { snav.classList.toggle('active', i===n); snav.classList.toggle('text-slate-400', i!==n); }
+    if (conn) conn.classList.toggle('done', i < n);
+  }
+
+  // AI tip
+  const tip = AI_TIPS[n];
+  const tipEl = document.getElementById('ai-tip');
+  const actEl = document.getElementById('ai-actions');
+  if (tip && tipEl) { tipEl.textContent = tip.tip; }
+  if (tip && actEl) {
+    actEl.innerHTML = tip.actions.map(a => a.url
+      ? `<a href="${a.url}" target="_blank" rel="noopener" class="block w-full text-center px-3 py-2 rounded-xl bg-purple-950/40 border border-purple-800/30 text-purple-300 text-xs font-semibold hover:bg-purple-950/60 transition-all">${a.label}</a>`
+      : `<button onclick="${a.fn}" class="block w-full text-center px-3 py-2 rounded-xl bg-purple-950/40 border border-purple-800/30 text-purple-300 text-xs font-semibold hover:bg-purple-950/60 transition-all">${a.label}</button>`
+    ).join('');
+  }
+}
+
+// ── Integration save ────────────────────────────────────────────────────────────
+async function saveAndNext(section) {
+  let body = {};
+
+  if (section === 'ecommerce') {
+    body = {
+      etsy: { apiKey: v('etsy-apiKey'), shopId: v('etsy-shopId') },
+      amazon: { sellerId: v('amazon-sellerId'), mwsToken: v('amazon-mwsToken') },
+      tiktokShop: { appKey: v('tiktokShop-appKey'), appSecret: v('tiktokShop-appSecret') },
+    };
+  } else if (section === 'payments') {
+    body = {
+      stripe: { publishableKey: v('stripe-publishableKey'), secretKey: v('stripe-secretKey'), webhookSecret: v('stripe-webhookSecret') },
+      paypal: { clientId: v('paypal-clientId'), clientSecret: v('paypal-clientSecret') },
+    };
+  } else if (section === 'email') {
+    const provider = document.querySelector('input[name="emailProvider"]:checked')?.value || 'mailchimp';
+    body = { emailMarketing: { provider, apiKey: v('email-apiKey'), listId: v('email-listId') } };
+  }
+
+  const res = await api('/api/admin/integrations', { method: 'PUT', body: JSON.stringify(body) });
+  if (!res?.ok) {
+    showFeedback(`${section}-feedback`, '❌ Save failed. Please check your connection and try again.', false);
+    return;
+  }
+  showFeedback(`${section}-feedback`, '✅ Settings saved successfully!', true);
+  setTimeout(nextStep, 800);
+}
+
+function v(id) { return document.getElementById(id)?.value?.trim() || ''; }
+
+function showFeedback(id, msg, ok) {
+  const el = document.getElementById(id);
+  if (!el) return;
+  el.textContent = msg;
+  el.className = `mb-4 p-3 rounded-xl text-sm font-medium ${ok ? 'bg-emerald-950/40 border border-emerald-800/40 text-emerald-400' : 'bg-red-950/40 border border-red-800/40 text-red-400'}`;
+  el.classList.remove('hidden');
+}
+
+// ── Wizard Products ─────────────────────────────────────────────────────────────
+async function loadWizardProducts() {
+  const res = await api('/api/admin/products');
+  if (!res) return;
+  const data = await res.json();
+  const el = document.getElementById('wizard-products-list');
+  el.innerHTML = (data.products || []).map(p => `
+    <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/40" id="wprod-${p.id}">
+      <div class="flex items-center justify-between mb-3">
+        <div class="font-semibold text-white text-sm">${p.name} <span class="mono text-[11px] text-slate-500 ml-1">${p.sku}</span></div>
+        <span class="text-[11px] px-2 py-0.5 rounded-full font-bold ${p.inventory === 0 ? 'bg-red-950/50 text-red-400' : 'bg-emerald-950/50 text-emerald-400'}">${p.inventory === 0 ? 'Out of Stock' : `${p.inventory} in stock`}</span>
+      </div>
+      <div class="grid grid-cols-3 gap-2">
+        <div>
+          <label class="text-[10px] font-bold text-slate-600 uppercase mb-1 block">Price ($)</label>
+          <input type="number" step="0.01" value="${p.price}" id="wp-price-${p.id}" class="input-field w-full px-2 py-2 rounded-lg text-white text-sm font-mono" />
+        </div>
+        <div>
+          <label class="text-[10px] font-bold text-slate-600 uppercase mb-1 block">Stock</label>
+          <input type="number" value="${p.inventory}" id="wp-inv-${p.id}" class="input-field w-full px-2 py-2 rounded-lg text-white text-sm font-mono" />
+        </div>
+        <div class="flex items-end">
+          <button onclick="saveWizardProduct('${p.id}')" class="w-full py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition-all">Save</button>
+        </div>
+      </div>
+    </div>`).join('');
+}
+
+async function saveWizardProduct(id) {
+  const price = document.getElementById(`wp-price-${id}`)?.value;
+  const inventory = parseInt(document.getElementById(`wp-inv-${id}`)?.value);
+  const res = await api(`/api/admin/products/${id}`, { method: 'PUT', body: JSON.stringify({ price, inventory, status: inventory === 0 ? 'out_of_stock' : 'active' }) });
+  if (res?.ok) {
+    const el = document.getElementById(`wprod-${id}`);
+    if (el) { el.style.borderColor = 'rgba(16,185,129,0.4)'; setTimeout(() => el.style.borderColor = '', 1500); }
+  }
+}
+
+// ── Wizard Users ─────────────────────────────────────────────────────────────────
+async function loadWizardUsers() {
+  const res = await api('/api/admin/users');
+  if (!res) return;
+  const users = await res.json();
+  const me = JSON.parse(localStorage.getItem('admin_user') || '{}');
+  document.getElementById('wizard-users-list').innerHTML = users.map(u => `
+    <div class="flex items-center justify-between p-3 rounded-xl border border-slate-800 bg-slate-900/40">
+      <div>
+        <div class="font-semibold text-white text-sm">${u.email}</div>
+        <div class="text-[11px] text-slate-500">${u.role}${u.id===me.id?' · You':''}</div>
+      </div>
+      ${u.id !== me.id ? `<button onclick="deleteWizardUser('${u.id}','${u.email}')" class="text-xs text-red-400 hover:text-red-300 font-semibold px-2">Remove</button>` : ''}
+    </div>`).join('');
+}
+
+async function addWizardUser() {
+  const email = document.getElementById('wizard-user-email').value.trim();
+  const password = document.getElementById('wizard-user-password').value;
+  const errEl = document.getElementById('wizard-user-error');
+  errEl.classList.add('hidden');
+  if (!email || !password) { errEl.textContent = 'Email and password are required'; errEl.classList.remove('hidden'); return; }
+  const res = await api('/api/admin/users', { method: 'POST', body: JSON.stringify({ email, password }) });
+  const data = await res.json();
+  if (!res.ok) { errEl.textContent = data.error || 'Failed'; errEl.classList.remove('hidden'); return; }
+  document.getElementById('wizard-user-email').value = '';
+  document.getElementById('wizard-user-password').value = '';
+  loadWizardUsers();
+}
+
+async function deleteWizardUser(id, email) {
+  if (!confirm(`Remove "${email}"?`)) return;
+  const res = await api(`/api/admin/users/${id}`, { method: 'DELETE' });
+  if (res?.ok) loadWizardUsers();
+}
+
+// ── Populate fields from saved settings ─────────────────────────────────────────
+async function loadSavedSettings() {
+  const res = await api('/api/admin/integrations');
+  if (!res) return;
+  integrationSettings = await res.json();
+  const s = integrationSettings;
+  // E-commerce
+  setVal('etsy-shopId', s.etsy?.shopId);
+  setVal('amazon-sellerId', s.amazon?.sellerId);
+  setVal('tiktokShop-appKey', s.tiktokShop?.appKey);
+  // Payments
+  setVal('stripe-publishableKey', s.stripe?.publishableKey);
+  // Email
+  setVal('email-listId', s.emailMarketing?.listId);
+  if (s.emailMarketing?.provider) {
+    const radio = document.querySelector(`input[name="emailProvider"][value="${s.emailMarketing.provider}"]`);
+    if (radio) radio.checked = true;
+  }
+}
+
+function setVal(id, val) {
+  const el = document.getElementById(id);
+  if (el && val) el.value = val;
+}
+
+// ── Sidebar ────────────────────────────────────────────────────────────────────
+function toggleSidebar() {
+  document.getElementById('sidebar').classList.toggle('open');
+  document.getElementById('overlay').classList.toggle('hidden');
+}
+function closeSidebar() {
+  document.getElementById('sidebar').classList.remove('open');
+  document.getElementById('overlay').classList.add('hidden');
+}
+
+// ── Init ──────────────────────────────────────────────────────────────────────
+goToStep(0);
+loadSavedSettings();
+</script>
+</body>
+</html>
diff --git a/sites/queenscustoms/qc-integration.js b/sites/queenscustoms/qc-integration.js
new file mode 100644
index 0000000..c074904
--- /dev/null
+++ b/sites/queenscustoms/qc-integration.js
@@ -0,0 +1,192 @@
+/**
+ * Queens Customs Shop — Admin Backend Integration
+ * ================================================
+ * Drop this script into queenscustoms.shop to wire up:
+ *   1. Contact form → Admin Inquiries inbox
+ *   2. Cart checkout → Admin Orders dashboard
+ *   3. Product catalog → live inventory from admin backend
+ *
+ * SETUP:
+ *   1. Host this file or paste it inline in your site's <script> tag.
+ *   2. Set QC_API_BASE to the URL where your admin server runs.
+ *      Examples:
+ *        - Local dev:  'http://localhost:3000'
+ *        - Production: 'https://your-server-url.com'  (or your Cloudflare tunnel URL)
+ *
+ * USAGE:
+ *   Each integration is opt-in. Only call the functions you need.
+ */
+
+const QC_API_BASE = window.QC_API_BASE || 'http://localhost:3000';
+
+// ─────────────────────────────────────────────────────────────────────────────
+// 1. CONTACT FORM INTEGRATION
+//    Submits the contact/custom-order form to the Admin Inquiries inbox.
+//
+//    Usage — attach to your form's submit event:
+//
+//      document.getElementById('your-contact-form').addEventListener('submit', QC.submitContactForm);
+//
+//    OR call directly:
+//
+//      await QC.submitInquiry({ name, email, subject, message });
+// ─────────────────────────────────────────────────────────────────────────────
+
+const QC = {
+
+  /**
+   * Submit an inquiry directly (called programmatically).
+   * Returns { success: true, id, message } on success.
+   */
+  async submitInquiry({ name, email, subject, message, source = 'website' }) {
+    const res = await fetch(`${QC_API_BASE}/api/inquiries`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name, email, subject, message, source }),
+    });
+    const data = await res.json();
+    if (!res.ok) throw new Error(data.error || 'Submission failed');
+    return data;
+  },
+
+  /**
+   * Wire to a form's submit event.
+   * Reads: name="#name-field" email="#email-field" subject="#subject-field" message="#message-field"
+   * OR pass field IDs: QC.submitContactForm(event, { nameId, emailId, subjectId, messageId })
+   *
+   * Example HTML:
+   *   <form id="contact-form">
+   *     <input id="contact-name"    name="name"    ... />
+   *     <input id="contact-email"   name="email"   ... />
+   *     <input id="contact-subject" name="subject" ... />
+   *     <textarea id="contact-msg"  name="message" ...></textarea>
+   *     <button type="submit">Send Message 👑</button>
+   *   </form>
+   *
+   *   <script>
+   *     document.getElementById('contact-form').addEventListener('submit', QC.submitContactForm);
+   *   </script>
+   */
+  async submitContactForm(event, ids = {}) {
+    event.preventDefault();
+    const {
+      nameId = 'contact-name',
+      emailId = 'contact-email',
+      subjectId = 'contact-subject',
+      messageId = 'contact-msg',
+      topicId = 'contact-topic',
+    } = ids;
+
+    const name    = document.getElementById(nameId)?.value?.trim();
+    const email   = document.getElementById(emailId)?.value?.trim();
+    const subject = document.getElementById(subjectId)?.value?.trim()
+                 || document.getElementById(topicId)?.value?.trim()
+                 || 'Contact Form Submission';
+    const message = document.getElementById(messageId)?.value?.trim();
+
+    const btn = event.target.querySelector('[type="submit"]');
+    const originalText = btn?.textContent;
+    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
+
+    try {
+      await QC.submitInquiry({ name, email, subject, message });
+      if (btn) btn.textContent = '✓ Message Sent! The Vibe Queen will reply within 24hrs 👑';
+      event.target.reset();
+    } catch (err) {
+      console.error('[QC] Contact form error:', err.message);
+      if (btn) { btn.disabled = false; btn.textContent = originalText; }
+      alert('Message could not be sent. Please DM on TikTok instead! 👑');
+    }
+  },
+
+  // ─────────────────────────────────────────────────────────────────────────
+  // 2. CART / ORDER INTEGRATION
+  //    Submits a completed cart to the Admin Orders dashboard.
+  //
+  //    Usage:
+  //      const result = await QC.submitOrder({
+  //        customer: { name: 'Brianna Scott', email: 'b@email.com', address: '...' },
+  //        items: [{ name: 'Pink Glitter Queen Tumbler (30oz)', qty: 1, price: '40.00' }],
+  //        total: '40.00',
+  //        channel: 'Website',  // 'Website' | 'TikTok Shop' | 'Etsy' | 'Amazon'
+  //        notes: 'Gift wrap please',
+  //      });
+  //      // result.orderNumber → 'QC-10009'
+  // ─────────────────────────────────────────────────────────────────────────
+
+  async submitOrder({ customer, items, total, channel = 'Website', notes = '' }) {
+    const res = await fetch(`${QC_API_BASE}/api/orders`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ customer, items, total, channel, notes }),
+    });
+    const data = await res.json();
+    if (!res.ok) throw new Error(data.error || 'Order submission failed');
+    return data; // { success, orderNumber, orderId, message }
+  },
+
+  // ─────────────────────────────────────────────────────────────────────────
+  // 3. LIVE PRODUCT CATALOG
+  //    Fetches the current inventory from the admin backend so your site
+  //    always shows accurate stock levels and "Only X left!" badges.
+  //
+  //    Usage:
+  //      const products = await QC.getProducts();
+  //      // products → [{ id, name, price, inventory, inStock, lowStock, ... }]
+  // ─────────────────────────────────────────────────────────────────────────
+
+  async getProducts() {
+    const res = await fetch(`${QC_API_BASE}/api/products`);
+    if (!res.ok) throw new Error('Failed to load products');
+    return res.json();
+  },
+
+  /**
+   * Update all product cards on the page with live stock data.
+   * Looks for elements with data-sku="QC-T001" or data-product-id="..." attributes.
+   *
+   * Example HTML:
+   *   <div data-sku="QC-T001">
+   *     <span class="qc-stock-badge"></span>
+   *     <button class="qc-add-to-cart">Add to Cart</button>
+   *   </div>
+   */
+  async syncInventoryBadges() {
+    try {
+      const products = await QC.getProducts();
+      const byId  = Object.fromEntries(products.map(p => [p.id,  p]));
+      const bySku = Object.fromEntries(products.map(p => [p.sku, p]));
+
+      document.querySelectorAll('[data-sku],[data-product-id]').forEach(el => {
+        const p = bySku[el.dataset.sku] || byId[el.dataset.productId];
+        if (!p) return;
+
+        const badge = el.querySelector('.qc-stock-badge');
+        const cartBtn = el.querySelector('.qc-add-to-cart');
+
+        if (badge) {
+          badge.textContent = p.inStock
+            ? (p.lowStock ? `🔥 Only ${p.inventory} Left!` : '')
+            : '⚠️ Sold Out';
+          badge.style.display = (!p.inStock || p.lowStock) ? '' : 'none';
+        }
+        if (cartBtn) {
+          cartBtn.disabled = !p.inStock;
+          cartBtn.textContent = p.inStock ? 'Add to Cart' : 'Sold Out';
+        }
+      });
+    } catch (err) {
+      console.warn('[QC] Could not sync inventory badges:', err.message);
+    }
+  },
+};
+
+// Auto-run: sync inventory badges on page load if any tagged elements exist
+document.addEventListener('DOMContentLoaded', () => {
+  if (document.querySelector('[data-sku],[data-product-id]')) {
+    QC.syncInventoryBadges();
+  }
+});
+
+// Expose globally so inline onclick handlers can access it
+window.QC = QC;
