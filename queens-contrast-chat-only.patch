+/* ── Queen Chat widget ───────────────────────────────────── */
+.queen-chat {
+  position: fixed;
+  bottom: 24px;
+  left: 20px;
+  z-index: 1000;
+  font-family: var(--font-body);
+}
+.queen-chat-fab {
+  width: 64px;
+  height: 64px;
+  border-radius: 50%;
+  border: 2px solid #FF1A8C;
+  padding: 0;
+  cursor: pointer;
+  overflow: hidden;
+  background: #111;
+  box-shadow: 0 8px 28px rgba(255, 26, 140, 0.45), 0 0 0 4px rgba(255, 26, 140, 0.15);
+  transition: transform 0.2s var(--ease-out), box-shadow 0.2s ease;
+  position: relative;
+}
+.queen-chat-fab:hover {
+  transform: scale(1.06);
+  box-shadow: 0 10px 34px rgba(255, 26, 140, 0.55), 0 0 0 5px rgba(255, 26, 140, 0.2);
+}
+.queen-chat-fab img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center top;
+  display: block;
+}
+.queen-chat-fab .qc-pulse {
+  position: absolute;
+  inset: -4px;
+  border-radius: 50%;
+  border: 2px solid rgba(255, 26, 140, 0.55);
+  animation: qcPulse 2.2s ease-out infinite;
+  pointer-events: none;
+}
+@keyframes qcPulse {
+  0% { transform: scale(1); opacity: 0.7; }
+  100% { transform: scale(1.35); opacity: 0; }
+}
+.queen-chat-fab .qc-dot {
+  position: absolute;
+  top: 4px;
+  right: 4px;
+  width: 12px;
+  height: 12px;
+  background: #22c55e;
+  border: 2px solid #0d0d0d;
+  border-radius: 50%;
+}
+.queen-chat-tip {
+  position: absolute;
+  left: 76px;
+  bottom: 14px;
+  white-space: nowrap;
+  background: rgba(13, 13, 13, 0.94);
+  color: #fff;
+  border: 1px solid rgba(255, 26, 140, 0.45);
+  border-radius: 999px;
+  padding: 8px 14px;
+  font-size: 0.78rem;
+  font-weight: 600;
+  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
+  opacity: 0;
+  transform: translateX(-6px);
+  pointer-events: none;
+  transition: opacity 0.25s ease, transform 0.25s ease;
+}
+.queen-chat:not(.open) .queen-chat-tip.show {
+  opacity: 1;
+  transform: translateX(0);
+}
