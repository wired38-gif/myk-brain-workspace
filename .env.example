# ──────────────────────────────────────────────────────────────────────────────
# Admin Portal Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.
# ──────────────────────────────────────────────────────────────────────────────

# JWT secret for signing admin tokens (use a long random string in production)
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-string

# JWT token expiry (e.g. 8h, 1d, 7d)
ADMIN_JWT_EXPIRES_IN=8h

# Initial master admin credentials — used by the seed script on first run.
# Change after first login!
ADMIN_SEED_EMAIL=mike@myk.com
ADMIN_SEED_PASSWORD=87188718

# Server port
PORT=3000

# Browser auto-open is disabled in code. Chrome restore was opening Mixpanel.
# /api/open rejects Chrome/Safari and mixpanel.com; /api/terminal rejects open http…
