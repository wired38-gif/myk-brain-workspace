+ * Setup Coach — plain-English answers for non-technical admins.
+ * Rule-based by default; uses OPENAI_API_KEY / SETUP_COACH_API_KEY when set.
+ */
+function setupCoachReply(message, guideId, wizardStep) {
+  const q = String(message || '').toLowerCase().trim();
+  const guide = String(guideId || 'overview');
+  const step = typeof wizardStep === 'number' ? wizardStep : 0;
+
+  const pack = (reply, extra) => Object.assign({
+    reply,
+    replyHtml: reply,
+    suggestGuide: null,
+    openUrl: null,
+    openLabel: null,
+  }, extra || {});
+
+  if (!q) {
+    return pack('Ask me anything — for example: “What is an API key?” or “Where do I find my Etsy Shop ID?”');
+  }
+
+  if (/(what('?s| is) an? )?api key|what are (these|those) keys|secret key|client secret|app secret/.test(q)) {
+    return pack(
+      'An <strong>API key</strong> (or Secret / App Secret) is just a <em>secret password</em> that Etsy, Stripe, Google, etc. give you. ' +
+      'It proves this website is allowed to talk to <em>your</em> account. You copy it from their website and paste it in the box — you’re not buying a product. ' +
+      'Never post it on social media or email it to strangers.'
+    );
+  }
+
+  if (/skip|later|don'?t (have|sell|use)|not yet|optional|do i (need|have to)/.test(q)) {
+    return pack(
+      'Yes — most of these steps are optional. Leave the boxes empty and tap <strong>Save &amp; Continue</strong>. ' +
+      'Nothing breaks. You can reopen <strong>Setup</strong> anytime from the toggle at the top when you’re ready.'
+    );
+  }
+
+  if (/shop id|etsy/.test(q) && (/shop|id|etsy|find|where/.test(q) || guide === 'etsy' || step === 1)) {
+    return pack(
